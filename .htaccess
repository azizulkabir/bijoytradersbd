# Serve existing pages at their navigation URLs.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect browser requests for public HTML pages to extensionless URLs.
    # THE_REQUEST avoids redirecting internal rewrites back to these files.
    RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
    RewriteRule ^index\.html$ / [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+(about|products|contact)\.html[\s?] [NC]
    RewriteRule ^(about|products|contact)\.html$ /$1 [R=301,L]

    RewriteRule ^admin/?$ admin.html [L]
    RewriteRule ^about/?$ about.html [L]
    RewriteRule ^products?/?$ products.html [L]
    RewriteRule ^contact/?$ contact.html [L]
</IfModule>
